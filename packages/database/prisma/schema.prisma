// Money is ALWAYS stored as BigInt kobo (₦1 = 100 kobo). Never floats.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  OPENING
  SALARY
  TRANSFER_OUT
  TRANSFER_IN
  DEPOSIT
  WITHDRAWAL
  BILL
  PURCHASE
  FINE
  REFUND
  ADJUSTMENT
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String // argon2id
  username        String // as the player typed it
  usernameLower   String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime @db.Date
  phoneEnc        String // AES-256-GCM, never sent to other players
  phoneHash       String   @unique // keyed hash: blocks duplicate phones without storing them in the clear
  addressEnc      String // AES-256-GCM, never sent to other players
  termsAcceptedAt DateTime
  createdAt       DateTime @default(now())
  players         Player[]
}

model Player {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  character  Character?
}

model Character {
  id           String           @id @default(cuid())
  playerId     String           @unique
  player       Player           @relation(fields: [playerId], references: [id])
  name         String
  age          Int
  level        Int              @default(1)
  xp           Int              @default(0) // level is worked out from this
  socialClass  String
  homeName     String           @default("Small rented room")
  cashKobo     BigInt           @default(0)
  energy       Float              @default(85)
  hunger       Float              @default(80)
  health       Float              @default(100)
  happiness    Float              @default(60)
  stress       Float              @default(20)
  needsUpdatedAt  DateTime         @default(now()) // needs decay lazily from this moment
  actionCooldowns Json             @default("{}")
  reputation   Float            @default(15)
  occupationId String
  occupation   Occupation       @relation(fields: [occupationId], references: [id])
  account      BankAccount?
  employment   Employment?
  skills       CharacterSkill[]
  homeSlots    HomeSlot[]
  inventory    InventoryItem[]
  contacts     Contact[]
  sentMsgs     Message[]        @relation("MsgFrom")
  createdAt    DateTime         @default(now())
}

model Occupation {
  id         String      @id @default(cuid())
  key        String      @unique
  name       String
  jobs       Job[]
  characters Character[]
}

// A rung on a career ladder. Admin-editable; no code deploy needed.
model Job {
  id                String       @id @default(cuid())
  occupationId      String
  occupation        Occupation   @relation(fields: [occupationId], references: [id])
  rank              Int
  title             String
  monthlySalaryKobo BigInt
  shiftStartHour    Int          @default(6)
  shiftEndHour      Int          @default(12)
  minReputation     Float        @default(0)
  minShifts         Int          @default(0)
  minLevel          Int          @default(1)
  skillKey          String?
  minSkill          Int          @default(0)
  employments       Employment[]

  @@unique([occupationId, rank])
}

model Employment {
  id           String    @id @default(cuid())
  characterId  String    @unique
  character    Character @relation(fields: [characterId], references: [id])
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id])
  shiftsWorked Int       @default(0)
  lastShiftDay Int       @default(-1) // server game-day of last paid shift
  startedAt    DateTime  @default(now())
  shiftStartedAt DateTime?           // set while a 20-minute shift is running; cleared when it ends or is abandoned
  shiftsToday  Int       @default(0) // shifts finished on day `lastShiftDay`
}

model CharacterSkill {
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  key         String
  level       Int       @default(0)

  @@id([characterId, key])
}

model BankAccount {
  id            String        @id @default(cuid())
  characterId   String        @unique
  character     Character     @relation(fields: [characterId], references: [id])
  accountNumber String        @unique // 10 digits
  balanceKobo   BigInt        @default(0) // CHECK >= 0 enforced in SQL migration
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
}

// Append-only ledger. Never updated or deleted (trigger in migration).
model Transaction {
  id               String      @id @default(cuid())
  accountId        String
  account          BankAccount @relation(fields: [accountId], references: [id])
  type             TxType
  amountKobo       BigInt // signed: negative = debit
  balanceAfterKobo BigInt
  description      String
  idempotencyKey   String      @unique // replay protection
  counterpartyId   String?
  meta             Json?
  createdAt        DateTime    @default(now())

  @@index([accountId, createdAt])
}

model EconomyConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id        String   @id @default(cuid())
  playerId  String?
  action    String
  severity  String   @default("info") // info | warn | suspicious
  detail    Json?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([severity, createdAt])
}

model Contact {
  id       String    @id @default(cuid())
  ownerId  String
  owner    Character @relation(fields: [ownerId], references: [id])
  name     String
  kind     String
  npcKey   String?
  relation Int       @default(0)

  @@index([ownerId])
}

model Message {
  id        String    @id @default(cuid())
  fromId    String
  from      Character @relation("MsgFrom", fields: [fromId], references: [id])
  toRef     String
  body      String
  createdAt DateTime  @default(now())

  @@index([toRef, createdAt])
}
// TODO next: Property, Room, Furniture, Inventory, Vehicle, Business, NPC, Relationship, Mission, Event, Achievement.

// One row per upgradeable thing in the home. tier 0 = what a poor character starts with.
model HomeSlot {
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  slot        String
  tier        Int       @default(0)

  @@id([characterId, slot])
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  key         String
  name        String
  qty         Int       @default(1)

  @@unique([characterId, key])
}
