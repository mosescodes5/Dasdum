# Copy this to `.env` (git-ignored) and fill in real values.
#
# On cPanel, set these as environment variables in "Setup Node.js App"
# for your app (there's a section for this once the app is created), OR
# put them in a `.env` file next to server.js and require("dotenv/config")
# at the very top of server.js — see README.md for both options.

# --- Database (from cPanel's "MySQL Database Wizard") ---
# cPanel prefixes both the database name and user with your cPanel
# username, e.g. `cpaneluser_dasdum` / `cpaneluser_shop`.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_dasdum
DB_USER=cpaneluser_shop
DB_PASSWORD=

# --- File uploads ---
# Absolute path OUTSIDE your app's deployed folder, e.g.
# /home/cpaneluser/dasdum-uploads — see src/lib/uploads.ts.
UPLOADS_DIR=/home/cpaneluser/dasdum-uploads

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://dasdum.co.uk

# --- Money (these are read at BUILD time: change them, then rebuild) ---
# ISO 4217 currency code and the locale used to format numbers.
NEXT_PUBLIC_CURRENCY=GBP
NEXT_PUBLIC_LOCALE=en-GB
# Shipping prices in normal units (4.95 means 4.95 of the currency above).
NEXT_PUBLIC_SHIPPING_STANDARD=4.95
NEXT_PUBLIC_SHIPPING_EXPRESS=12.95
# Basket value for free shipping; leave empty to turn free shipping off.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=120
# Two price-filter breakpoints on the shop page, comma separated, normal units.
NEXT_PUBLIC_PRICE_BREAKPOINTS=60,150

# --- Contact details shown on the site (all optional) ---
# Anything left blank is simply not shown — no placeholder is displayed.
# Read at BUILD time like the money settings above.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_PINTEREST_URL=

# Only this admin email can see/use "Site Images" in the dashboard
# (homepage banner, brand-story photo, category photos) — every other
# admin account, regardless of role, won't see that section at all.
DEVELOPER_EMAIL=mosesoluwa2005@gmail.com

# --- Secrets ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Stripe (dashboard.stripe.com > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email, sent through a mailbox you create in cPanel > Email Accounts (e.g.
# orders@dasdum.co.uk) — no third-party service needed. Leave SMTP_HOST blank
# to turn email off entirely: nothing else breaks, emails are just skipped
# and logged. See the README's "Order and contact emails" section.
SMTP_HOST=mail.dasdum.co.uk
SMTP_PORT=465
SMTP_USER=orders@dasdum.co.uk
SMTP_PASSWORD=
# Optional. Defaults to "DASDUM <SMTP_USER>"; if you set it, keep it on the
# same mailbox/domain or mail servers may reject or spam-folder it.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=you@dasdum.co.uk
